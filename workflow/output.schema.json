{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ardjo-s/Picsou/schemas/attention-output-v1.json",
  "title": "Picsou science attention triage output",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow_version", "results"],
  "properties": {
    "workflow_version": {
      "const": "1.0.0"
    },
    "results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "title", "attention_fit", "priority", "signals"],
        "properties": {
          "case_id": { "type": "string" },
          "title": { "type": "string" },
          "attention_fit": { "type": "boolean" },
          "priority": {
            "enum": ["high", "medium", "skip"]
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "signal_type",
                "source_url",
                "evidence_quote",
                "confidence"
              ],
              "properties": {
                "source_id": { "type": "string" },
                "signal_type": {
                  "enum": ["relevance_hook", "method_signal", "impact_claim"]
                },
                "source_url": { "type": "string", "format": "uri" },
                "evidence_quote": { "type": "string", "minLength": 10 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
